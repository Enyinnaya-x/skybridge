// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum APIKEYTYPE{
  LIVE
  TEST
}

enum TrxnStatus{
  COMPLETED
  PENDING
  FAILED
}

model User{
    id String @id @default(uuid(7))
    first_name String
    last_name String
    business_name String @unique
    email String @unique
    email_verfied Boolean @default(false)
    email_verified_at DateTime?
    phone String @unique
    phone_verified Boolean @default(false)
    phone_verified_at DateTime?
    password String
    country_code String
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt
    api ApiKeys[]
    virtualaccount VirtualAccounts[]
    transactions Transactions[]

    @@index([id, email, phone])
}

model ApiKeys {
  id String @id @default(uuid(7))
  user User? @relation(fields: [user_id], references: [id])
  user_id String?
  type APIKEYTYPE @default(LIVE)
  api_key String @unique
  is_valid Boolean @default(true)
  expires_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, api_key])
}

model VirtualAccounts{
  id String @id @default(uuid(7))
  acc_num String
  bank_name String
  amount BigInt
  is_valid Boolean @default(true)
  expires_at DateTime
  user User? @relation(fields: [user_id], references: [id])
  user_id String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  transactions Transactions[]

  @@index([user_id, id])
}

model Transactions{
  id String @id @default(uuid(7))
  user User? @relation(fields: [user_id], references: [id])
  user_id String
  virtual_account VirtualAccounts? @relation(fields: [virtual_acc_id], references: [id])
  virtual_acc_id String?
  amount BigInt
  customer_email String
  status TrxnStatus
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}